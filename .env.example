# Copy this file to .env and fill in your own values. .env is gitignored;
# never commit your actual calendar ID or credential file paths if they
# reveal anything personal.

# The Google Calendar to operate on. Use "primary" for the account's main
# calendar, or a specific calendar's ID (Google Calendar > Settings >
# [calendar name] > Integrate calendar > Calendar ID).
GOOGLE_CALENDAR_ID=primary

# Paths to the OAuth files described in the README's "Google OAuth
# credentials" section. These default to /etc/secrets/..., matching a
# Render Secret File mount (see the README's "Deploying" section) — if
# running locally instead, point these at wherever you keep the files,
# e.g. ./credentials.json and ./token.json.
GOOGLE_OAUTH_CREDENTIALS_PATH=/etc/secrets/credentials.json
GOOGLE_OAUTH_TOKEN_PATH=/etc/secrets/token.json
