# Copy this file to .env and fill in your own values. .env is gitignored;
# never commit your actual calendar ID or credential file paths if they
# reveal anything personal.

# The Google Calendar to operate on. This app can only access calendars it
# has created itself (see the README's "Calendar access model") — "primary"
# and other pre-existing calendars will not work. If you don't have one
# yet, run `python create_calendar.py` first (it only needs
# GOOGLE_OAUTH_CREDENTIALS_PATH/GOOGLE_OAUTH_TOKEN_PATH below, not this
# variable) and set this to the id it prints.
GOOGLE_CALENDAR_ID=

# Paths to the OAuth files described in the README's "Google OAuth
# credentials" section. These default to credentials.json/token.json in
# the project root, which are gitignored — convenient for local
# development. When deployed, override these to somewhere with real
# protections, e.g. a Render Secret File mount (see the README's
# "Deploying" section):
#   GOOGLE_OAUTH_CREDENTIALS_PATH=/etc/secrets/credentials.json
#   GOOGLE_OAUTH_TOKEN_PATH=/etc/secrets/token.json
GOOGLE_OAUTH_CREDENTIALS_PATH=credentials.json
GOOGLE_OAUTH_TOKEN_PATH=token.json
